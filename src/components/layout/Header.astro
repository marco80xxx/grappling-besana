---
import Navigation from "./Navigation.astro";
import ThemeIcon from "../ui/ThemeIcon.astro";
import Social from "../ui/Social.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const [staticData] = await getCollection("staticData");
const { github, githubIconName, whatsapp, whatsappIconName, instagram, instagramIconName } = staticData.data;

const currentPath = Astro.url.pathname;
const routes = ["/", "/portfolio", "/about-us"];

// Check if the current route is in the list of routes
const isActiveRoute = routes.includes(currentPath);

const navItems = isActiveRoute
  ? ["home", "orari", "projects", "where", "about"]
  : ["home", "about"]; // Change the items
---

<header
  role="banner"
  aria-label="Main navigation"
  class="sticky top-0 z-50 w-full p-8 font-medium text-blacktext dark:text-zinc-300 dark:bg-[#0E0E11]/80 dark:border-b dark:border-zinc-800 bg-white/90 backdrop-blur-xs dark:backdrop-blur-xs max-md:z-50 max-md:px-0 transition-all"
>
  <div
    class="relative mx-auto flex max-w-7xl flex-row items-center justify-between max-xl:px-6"
  >
    <a
      href="/"
      aria-label="Go to home"
      class="flex items-center gap-2 text-blacktext dark:text-white hover:text-mint-300 dark:hover:text-mint-300 transition-all"
    >
      <Icon name="gb-mini-logo" class="h-6 w-6 cursor-pointer" aria-hidden="true" />
      <span class="font-black text-lg leading-none max-sm:hidden">Grappling Besana</span>
    </a>

    <Navigation items={navItems} />

    <div class="flex items-center justify-between gap-5 text-xl">
      <div
        class="max-md:hidden flex items-center justify-center gap-5"
        role="group"
      >
        <Social link={whatsapp} iconName={whatsappIconName} />
      </div>
      <div
        class="max-md:hidden flex items-center justify-center gap-5"
        role="group"
      >
        <Social link={instagram} iconName={instagramIconName} />
      </div>
    </div>
    <div class="flex items-center gap-5 text-xl md:pl-5">
      <ThemeIcon />
      <button
        class="hamburger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="bars" class="hamburger-icon bars-icon" aria-hidden="true" />
        <Icon
          name="xmark"
          class="hamburger-icon xmark-icon"
          aria-hidden="true"
        />
      </button>
    </div>
  </div>
</header>
