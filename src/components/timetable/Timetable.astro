---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getLocalImage } from "../../utils/images";
import { stagione } from "../../data/orari";
import TimetableTable from "./TimetableTable.astro";

const [staticData] = await getCollection("staticData");
const { timetableImage, timetableTitle } = staticData.data;

const timetableLocalImage = getLocalImage(timetableImage);
const posterAlt = `Locandina con gli orari settimanali dei corsi di Grappling Besana, stagione ${stagione}: grappling, BJJ, judo e S&C dal lunedì al sabato`;
---

<section class="py-8 px-8 max-md:py-1 mb-4 scroll-m-16" id="timetable">
    <h2
        class="text-4xl font-bold leading-12 text-blacktext dark:text-white items-center justify-center text-center"
        >
        {timetableTitle}
    </h2>

<div class="mx-auto max-w-7xl py-8">
    <div class="z-2 text-center mx-auto text-lg max-xl:text-base max-w-4xl dark:text-gray-200 text-blacktext my-6 leading-6 font-medium">
        <p class="mb-8">Scopri la programmazione ufficiale dei corsi per la nuova stagione. Un'offerta completa di Grappling, BJJ, Judo e Strength & Conditioning strutturata per soddisfare ogni esigenza di training, dai turni in pausa pranzo fino alle sessioni serali e al weekend.</p>
    </div>

    <div class="mx-auto w-full max-w-3xl max-sm:-mx-4 max-sm:w-auto">
        <TimetableTable />
    </div>

    {
      timetableLocalImage && (
        <div class="mx-auto mt-12 flex w-full max-w-sm flex-col items-center gap-3">
            <button
                id="timetable-trigger"
                type="button"
                aria-label="Ingrandisci la locandina degli orari"
                class="group relative block w-full cursor-zoom-in overflow-hidden rounded-2xl"
            >
                <Image
                    src={timetableLocalImage}
                    alt={posterAlt}
                    width={700}
                    class="block w-full transition-transform duration-500 group-hover:scale-[1.03]"
                />
                <span
                    class="pointer-events-none absolute bottom-3 right-3 rounded-full bg-black/60 p-2 text-white backdrop-blur-sm transition-colors group-hover:bg-mint-600"
                    aria-hidden="true"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        class="h-4 w-4"
                    >
                        <circle cx="11" cy="11" r="7" />
                        <path d="M21 21l-4.3-4.3M11 8v6M8 11h6" />
                    </svg>
                </span>
            </button>
            <p class="text-sm font-semibold text-blacktext/60 dark:text-zinc-400">
                La locandina degli orari: clicca per ingrandire
            </p>
        </div>
      )
    }

    <slot />
  </div>

<!-- Lightbox Overlay (inizialmente nascosto) -->
<div
    id="timetable-lightbox"
    class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 cursor-pointer"
>
    <div class="relative max-w-5xl w-full max-h-[90vh] flex items-center justify-center">
        <!-- Pulsante di chiusura -->
        <button
            id="lightbox-close"
            class="absolute top-4 right-4 text-white bg-black/50 hover:bg-black/80 rounded-full p-2 w-10 h-10 flex items-center justify-center text-xl font-bold transition-colors z-10"
            aria-label="Chiudi"
        >
            &times;
        </button>
        <!-- Immagine ingrandita con bordi arrotondati -->
        {timetableLocalImage ? (
          <Image
            src={timetableLocalImage}
            alt={posterAlt}
            width={1400}
            class="max-h-[85vh] max-w-full rounded-2xl object-contain shadow-2xl cursor-default"
            id="lightbox-img"
          />
        ) : null}
    </div>
</div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const trigger = document.getElementById('timetable-trigger');
        const lightbox = document.getElementById('timetable-lightbox');
        const closeBtn = document.getElementById('lightbox-close');
        const lightboxImg = document.getElementById('lightbox-img');

        if (trigger && lightbox && closeBtn && lightboxImg) {
            // Apri lightbox al click sull'immagine
            trigger.addEventListener('click', () => {
                lightbox.classList.remove('hidden');
                lightbox.classList.add('flex');
                document.body.style.overflow = 'hidden'; // Evita lo scroll della pagina sotto
            });

            // Funzione di chiusura
            const closeLightbox = () => {
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
                document.body.style.overflow = '';
            };

            // Chiudi cliccando sul pulsante 'X' o sullo sfondo scuro
            closeBtn.addEventListener('click', closeLightbox);
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox) {
                    closeLightbox();
                }
            });

            // Evita che il click sull'immagine la chiuda
            lightboxImg.addEventListener('click', (e) => {
                e.stopPropagation();
            });

            // Chiudi premendo il tasto ESC
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeLightbox();
                }
            });
        }
    });
</script>
