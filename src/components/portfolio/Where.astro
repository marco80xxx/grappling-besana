---
import { getCollection } from "astro:content";

const [staticData] = await getCollection("staticData");
const { whereTitle } = staticData.data;

const mapEmbedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3305.98533586759!2d9.27184837661615!3d45.690096618337705!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4786a5508f4f018d%3A0xf9aef426a001ed0c!2sGrappling%20Besana!5e1!3m2!1sit!2sit!4v1759391591537!5m2!1sit!2sit";
---

<section class="py-0 px-0 max-md:py-0 mb-0 scroll-m-24" id="where">
    <h2
        class="text-4xl font-bold mb-4 leading-14 text-blacktext dark:text-white items-center justify-center text-center"
        >
        📍{whereTitle}
    </h2>

    <div
        id="map-wrapper"
        class="relative isolate w-full h-[450px] bg-neutral-100 dark:bg-zinc-900 overflow-hidden"
        data-map-src={mapEmbedUrl}
    >
        <img
            src="/images/mappa-sede.webp"
            alt="Mappa della sede di Grappling Besana, presso la Polisportiva Besanese in via Alcide De Gasperi 89"
            width="1600"
            height="700"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
        />
        <button
            id="map-load-btn"
            type="button"
            aria-label="Apri la mappa interattiva (carica Google Maps)"
            class="group absolute inset-0 z-[1000] flex w-full h-full flex-col items-center justify-end gap-2 pb-8 cursor-pointer bg-black/10 hover:bg-black/20 transition-colors"
        >
            <span
                class="inline-flex items-center gap-2 rounded-full bg-mint-500 group-hover:bg-mint-600 text-white font-medium px-6 py-3 shadow-lg transition-colors"
                >Apri la mappa interattiva</span
            >
            <span
                class="rounded-full bg-black/60 px-3 py-1 text-xs font-medium text-white"
                >Verrà caricato Google Maps</span
            >
        </button>
    </div>
</section>

<script>
    document.getElementById("map-load-btn")?.addEventListener("click", () => {
        const wrapper = document.getElementById("map-wrapper");
        const src = wrapper?.dataset.mapSrc;
        if (!wrapper || !src) return;

        const iframe = document.createElement("iframe");
        iframe.src = src;
        iframe.width = "100%";
        iframe.height = "450";
        iframe.style.border = "0";
        iframe.loading = "lazy";
        iframe.referrerPolicy = "no-referrer-when-downgrade";
        iframe.setAttribute("allowfullscreen", "");
        iframe.title = "Mappa - Grappling Besana";

        wrapper.replaceChildren(iframe);
    });
</script>
