---
import { getCollection } from "astro:content";

const [staticData] = await getCollection("staticData");
const {
  whereTitle,
  geoLat,
  geoLng,
} = staticData.data;

const mapEmbedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3305.98533586759!2d9.27184837661615!3d45.690096618337705!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4786a5508f4f018d%3A0xf9aef426a001ed0c!2sGrappling%20Besana!5e1!3m2!1sit!2sit!4v1759391591537!5m2!1sit!2sit";
---
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<section class="py-0 px-0 max-md:py-0 mb-0 scroll-m-24" id="where">
    <h1
        class="text-4xl font-bold mb-4 leading-14 text-blacktext dark:text-white items-center justify-center text-center"
        >
        📍{whereTitle}
    </h1>

    <div
        id="map-wrapper"
        class="relative isolate w-full h-[450px] bg-neutral-100 dark:bg-zinc-900 overflow-hidden"
        data-map-src={mapEmbedUrl}
        data-lat={geoLat}
        data-lng={geoLng}
    >
        <div id="map-preview" class="absolute inset-0"></div>
        <button
            id="map-load-btn"
            type="button"
            aria-label="Apri la mappa interattiva"
            class="group absolute inset-0 z-[1000] flex w-full h-full items-center justify-center cursor-pointer bg-black/10 hover:bg-black/20 transition-colors"
        >
            <span
                class="inline-flex items-center gap-2 rounded-full bg-mint-500 group-hover:bg-mint-600 text-white font-medium px-6 py-3 shadow-lg transition-colors"
                >Apri la mappa interattiva</span
            >
        </button>
    </div>
</section>

<script>
    const wrapper = document.getElementById("map-wrapper");
    const preview = document.getElementById("map-preview");
    const lat = Number(wrapper?.dataset.lat);
    const lng = Number(wrapper?.dataset.lng);

    if (wrapper && preview && !Number.isNaN(lat) && !Number.isNaN(lng)) {
        // @ts-expect-error - remote ESM import, no local type declarations available
        import("https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js").then((L) => {
            L.Icon.Default.mergeOptions({
                iconRetinaUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png",
                iconUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png",
                shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
            });

            const map = L.map(preview, {
                center: [lat, lng],
                zoom: 16,
                zoomControl: false,
                dragging: false,
                scrollWheelZoom: false,
                doubleClickZoom: false,
                boxZoom: false,
                keyboard: false,
                touchZoom: false,
            });

            L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: "&copy; OpenStreetMap contributors",
            }).addTo(map);

            L.marker([lat, lng]).addTo(map);
        });
    }

    document.getElementById("map-load-btn")?.addEventListener("click", () => {
        const src = wrapper?.dataset.mapSrc;
        if (!wrapper || !src) return;

        const iframe = document.createElement("iframe");
        iframe.src = src;
        iframe.width = "100%";
        iframe.height = "450";
        iframe.style.border = "0";
        iframe.loading = "lazy";
        iframe.referrerPolicy = "no-referrer-when-downgrade";
        iframe.setAttribute("allowfullscreen", "");
        iframe.title = "Mappa - Grappling Besana";

        wrapper.replaceChildren(iframe);
    });
</script>