---
import Button from "../ui/Button.astro";

const bjjSquareUrl =
  "https://bjjsquare.com/it/palestre/grappling-besana-besana-brianza?utm_source=grapplingbesana&utm_medium=footer";
---

<section class="w-full border-t border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/40">
  <div
    class="mx-auto max-w-xl px-8 py-16 max-sm:px-4 max-sm:py-10 flex flex-col items-center text-center gap-6"
  >
    <div class="bg-white rounded-xl px-5 py-3 shadow-sm shrink-0">
      <img src="/images/logo-oriz.png" alt="BJJ Square" class="h-8 w-auto" />
    </div>
    <div class="max-w-md">
      <p class="font-bold text-lg text-blacktext dark:text-white">
        Siamo presenti su
        <a
          href={bjjSquareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-mint-600 dark:text-mint-400 hover:underline"
          >BJJ Square</a
        >
      </p>
      <p class="text-base text-blacktext/80 dark:text-gray-300 mt-1">
        Sei allievo di Grappling Besana? Iscriviti anche tu e ottieni
        statistiche e molto altro!
      </p>
    </div>
    <Button
      link={bjjSquareUrl}
      text="Iscriviti su BJJ Square"
      class="bg-none! bg-mint-500! hover:bg-mint-600! text-white! dark:text-white! shrink-0 px-4! py-2! text-sm!"
    />
  </div>
</section>
