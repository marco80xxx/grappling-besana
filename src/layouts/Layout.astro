---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import  SpeedInsights  from "@vercel/speed-insights/astro"
import { getCollection } from "astro:content";
const {
  pageTitle = "Grappling Besana - Scuola di Brazilian Jiu Jitsu a Besana in Brianza",
  description = "Benvenuti a Grappling Besana, la tua scuola di Brazilian Jiu Jitsu a Besana in Brianza. Unisciti a noi per imparare, crescere e competere in un ambiente amichevole e stimolante.",
  ogimage = {
    url: "/images/Grappling-Besana-Logo-Plain-SMALL.jpg",
    alt: "Grappling Besana - Scuola di Brazilian Jiu Jitsu a Besana in Brianza",
  },
  noindex = false,
} = Astro.props;

const siteUrl = new URL(Astro.url).origin;
const SEO = {
  sitename: "grappling besana",
  url: siteUrl,
  locale: "it_IT",
  author: "grappling besana",
  twitter: "@grapplingbesana",
};


const twitterimage = `${siteUrl}${ogimage.url}`;

const [staticData] = await getCollection("staticData");
const {
  profileName,
  telephone,
  email: businessEmail,
  instagram,
  whatsapp,
  streetAddress,
  addressLocality,
  postalCode,
  addressRegion,
  addressCountry,
  geoLat,
  geoLng,
} = staticData.data;

// Orari aggregati dalle pagine delle 3 discipline (Grappling, Judo, S&C) —
// aggiornare qui se cambiano gli orari dei corsi.
const openingHoursSpecification = [
  { dayOfWeek: "Monday", opens: "12:30", closes: "13:30" },
  { dayOfWeek: "Monday", opens: "18:30", closes: "21:00" },
  { dayOfWeek: "Tuesday", opens: "12:30", closes: "13:30" },
  { dayOfWeek: "Tuesday", opens: "19:30", closes: "21:00" },
  { dayOfWeek: "Wednesday", opens: "12:30", closes: "13:30" },
  { dayOfWeek: "Wednesday", opens: "18:30", closes: "21:00" },
  { dayOfWeek: "Thursday", opens: "12:30", closes: "13:30" },
  { dayOfWeek: "Thursday", opens: "19:30", closes: "21:00" },
  { dayOfWeek: "Friday", opens: "17:30", closes: "20:00" },
  { dayOfWeek: "Saturday", opens: "11:00", closes: "13:00" },
].map((spec) => ({
  "@type": "OpeningHoursSpecification",
  ...spec,
}));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  name: profileName,
  url: siteUrl,
  image: `${siteUrl}${ogimage.url}`,
  telephone,
  email: businessEmail,
  address: {
    "@type": "PostalAddress",
    streetAddress,
    addressLocality,
    postalCode,
    addressRegion,
    addressCountry,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: geoLat,
    longitude: geoLng,
  },
  sameAs: [instagram, whatsapp].filter(Boolean),
  openingHoursSpecification,
};
---

<html
  lang="it"
  class="dark:bg-[#0E0E11] bg-[#FFF] font-montserrat scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <!-- Favicon for different platforms -->
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/android-chrome-192x192.png" sizes="192x192" />
    <link rel="icon" href="/android-chrome-512x512.png" sizes="512x512" />

    <!-- Web manifest -->
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="description" content={description} />
    <meta name="author" content={SEO.author} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={`${Astro.site}${Astro.url.pathname}`}>
    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={twitterimage} />
    <meta property="og:image:alt" content={ogimage.alt} />
    <meta property="og:url" content={SEO.url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEO.sitename} />
    <meta property="og:locale" content={SEO.locale} />
    

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterimage} />
    <meta name="twitter:image:alt" content={ogimage.alt} />
    <meta name="twitter:site" content={SEO.twitter} />
  
    <meta name="theme-color" content="#0E0E11"/>

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  </head>
  <body class="overflow-x-hidden">
    <SpeedInsights/>
    <!--
    <div class="blur-circle"></div>
    <div
      style="background:linear-gradient(45deg, rgba(96, 250, 155, 0) 10.79%, rgba(250, 96, 96, 0.03) 40.92%, rgba(96, 250, 155, 0) 90.35%)"
      class="fixed top-0 left-0 w-full h-full pointer-events-none -z-1"
    >
    </div>
    -->
    <Header />

    <div class="min-h-[85vh] ">
      <slot />
    </div>

    <Footer />
    <script>
      import "../scripts/menu.js";
    </script>
  </body>
</html>
