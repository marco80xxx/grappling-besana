---
import Layout from "./Layout.astro";
import DatePub from "../components/ui/DatePub.astro";
import Heading from "../components/ui/Heading.astro";
import NavArticle from "../components/layout/NavArticle.astro";
import Contact from "../components/portfolio/Contact.astro";
import Project from "../components/portfolio/Project.astro";
import ShareButton from "../components/ui/ShareButton.astro";
import { Image, getImage } from "astro:assets";
import { getLocalImage } from "../utils/images";
const { frontmatter } = Astro.props;

interface ProjectFrontmatter {
  title: string;
  description: string;
  pubDate: string;
  image: { url: string; alt: string };
}

const allPosts = Object.values(
  import.meta.glob<{ frontmatter: ProjectFrontmatter; url: string }>(
    "../pages/portfolio/projects/*.md",
    { eager: true },
  ),
);
const otherPosts = allPosts.filter(
  (post) => post.frontmatter.title !== frontmatter.title,
);

const heroImage = frontmatter.image?.url ? getLocalImage(frontmatter.image.url) : undefined;
const ogImage = heroImage
  ? { url: (await getImage({ src: heroImage, width: 1200 })).src, alt: frontmatter.image.alt }
  : frontmatter.image;
---


<Layout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  ogimage={ogImage}
>
  <section
    class="relative mx-auto px-8 max-sm:px-4 flex flex-row justify-center gap-6"
  >
    <div class="w-64 max-xl:hidden"></div>
    <article
      class="flex flex-col gap-8 max-w-3xl max-md:w-full pb-10 pt-8 mt-8 px-14 max-md:px-10 max-sm:px-4  dark:bg-transparent bg-white dark:border-0 border border-neutral-100 rounded-2xl" 
    >
      <header class="flex flex-col gap-4" id="start">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <DatePub date={frontmatter.pubDate} />
          <ShareButton title={frontmatter.title} />
        </div>

        <Heading text={frontmatter.title} />
      </header>

      <figure>
        {
          heroImage ? (
            <Image class="w-full rounded-xl" src={heroImage} width={900} alt={frontmatter.image.alt || "Article image"} />
          ) : (
            frontmatter.image?.url && (
              <img
                class="w-full rounded-xl"
                src={frontmatter.image.url}
                alt={frontmatter.image.alt || "Article image"}
              />
            )
          )
        }
      </figure>

      <div class="markdown " id="content">
        <slot />
      </div>

      {
        otherPosts.length > 0 && (
          <div class="flex flex-col gap-4 pt-4 border-t border-neutral-100 dark:border-white/10">
            <Heading text="Le altre" textGradient="discipline" level={3} />
            <div class="grid grid-cols-2 max-sm:grid-cols-1 gap-4">
              {otherPosts.map((post) => (
                <Project
                  url={post.url}
                  title={post.frontmatter.title}
                  description={post.frontmatter.description}
                  image={post.frontmatter.image}
                />
              ))}
            </div>
          </div>
        )
      }
    </article>
    <NavArticle title={frontmatter.title} />
  </section>
  <div
    class="flex flex-col gap-6 max-w-4xl max-lg:py-2 py-3 max-xl:py-2 mx-auto"
  >
  

  </div>
  <Contact />
</Layout>
